}

// ── File upload zone ──────────────────────────────────────────────────────────

function UploadZone({ files, onFilesChange, uploading }) {
  const inputRef = useRef(null);
  const [dragging, setDragging] = useState(false);

  const addFiles = useCallback(
    (incoming) => {
      const valid = [];
      for (const f of incoming) {
        if (!validateFileExt(f)) {
          toast.error(`"${f.name}" is not a valid Excel file (.xlsx / .xls).`);
          continue;
        }
        if (f.size > MAX_FILE_SIZE_BYTES) {
          toast.error(`"${f.name}" exceeds ${MAX_FILE_SIZE_MB} MB limit.`);
          continue;
        }
        if (files.length + valid.length >= MAX_FILES) {
          toast.error(`Maximum ${MAX_FILES} files allowed per upload.`);
          break;
        }
        // Prevent duplicates by name
        if (files.some((ef) => ef.name === f.name)) {
          toast.warning(`"${f.name}" is already added.`);
          continue;
        }
        valid.push(f);
      }
      if (valid.length) onFilesChange([...files, ...valid]);
    },
    [files, onFilesChange]
  );

  const handleDrop = (e) => {
    e.preventDefault();
    setDragging(false);
    addFiles(Array.from(e.dataTransfer.files));
  };

  const handleInputChange = (e) => {
    addFiles(Array.from(e.target.files));
    // Reset so same file can be re-added after removal
    e.target.value = "";
  };

  const removeFile = (idx) => {
    onFilesChange(files.filter((_, i) => i !== idx));
  };

  return (
    <div className="space-y-3">
      {/* Drop zone */}
      <div
        onDragOver={(e) => { e.preventDefault(); setDragging(true); }}
        onDragLeave={() => setDragging(false)}
        onDrop={handleDrop}
        onClick={() => !uploading && inputRef.current?.click()}
        className={`relative flex flex-col items-center justify-center gap-3 px-6 py-10 rounded-2xl border-2 border-dashed cursor-pointer transition select-none ${
          dragging
            ? "border-amber-400 bg-amber-50"
            : uploading
            ? "border-stone-200 bg-stone-50 cursor-not-allowed opacity-60"
            : "border-stone-200 bg-stone-50 hover:border-amber-400 hover:bg-amber-50/50"
        }`}
      >
        <div className="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-100 text-amber-600">
          <Upload className="h-6 w-6" />
        </div>
        <div className="text-center">
          <p className="text-sm font-bold text-stone-700">
            Drag & drop Excel files here
          </p>
          <p className="text-xs text-stone-400 mt-1">
            or click to browse — .xlsx / .xls, max {MAX_FILE_SIZE_MB} MB each,
            up to {MAX_FILES} files
          </p>
        </div>
        <input
          ref={inputRef}
          type="file"
          multiple
          accept=".xlsx,.xls"
          className="hidden"
          onChange={handleInputChange}
          disabled={uploading}
        />
      </div>

      {/* Selected file list */}
      {files.length > 0 && (
        <ul className="space-y-2">
          {files.map((f, i) => (
            <li
              key={i}
              className="flex items-center gap-3 px-4 py-3 rounded-2xl bg-stone-50 ring-1 ring-stone-100"
            >
              <FileSpreadsheet className="h-5 w-5 text-emerald-500 shrink-0" />
              <div className="flex-1 min-w-0">
                <p className="text-sm font-semibold text-stone-800 truncate">
                  {f.name}
                </p>
                <p className="text-xs text-stone-400">{fileSizeStr(f.size)}</p>
              </div>
              {!uploading && (
                <button
                  onClick={(e) => { e.stopPropagation(); removeFile(i); }}
                  className="shrink-0 text-stone-400 hover:text-red-500 transition"
                >
                  <X className="h-4 w-4" />
                </button>
              )}
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}

// ── Preview table ─────────────────────────────────────────────────────────────

function PreviewTable({ rows, token, filePaths, onReupload }) {
  const [downloading, setDownloading] = useState(false);
  const [showAll, setShowAll] = useState(false);

  const invalidRows = rows.filter((r) => r.validationStatus === "invalid");
  const errorCount = invalidRows.length;
  const displayRows = showAll ? rows : rows.slice(0, 50);

  const handleDownloadErrorReport = async () => {
    if (!filePaths?.length) return;
    setDownloading(true);
    try {
      const blob = await downloadErrorReport(token, filePaths);
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `error_report_${token.slice(0, 8)}.xlsx`;
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      toast.error(
        err?.response?.data?.message || "Failed to download error report."
      );
    } finally {
      setDownloading(false);
    }
  };

  return (
    <div className="space-y-4">
      {/* Summary bar */}
      <div className="flex flex-wrap items-center justify-between gap-3">
        <div className="flex items-center gap-3 flex-wrap">
          <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-stone-100 text-stone-700">
            <FileText className="h-3.5 w-3.5" />
            {rows.length} total rows
          </span>
          <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 text-emerald-700">
            <CheckCircle2 className="h-3.5 w-3.5" />
            {rows.length - errorCount} valid
          </span>
          {errorCount > 0 && (
            <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-red-100 text-red-700">
              <XCircle className="h-3.5 w-3.5" />
              {errorCount} error{errorCount !== 1 ? "s" : ""}
            </span>
          )}
        </div>
        <div className="flex items-center gap-2 flex-wrap">
          {errorCount > 0 && (
            <button
              onClick={handleDownloadErrorReport}
              disabled={downloading}
              className="inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-bold text-red-700 bg-red-100 hover:bg-red-200 disabled:opacity-50 disabled:cursor-not-allowed transition"
            >
              {downloading ? (
                <Loader2 className="h-3.5 w-3.5 animate-spin" />
              ) : (
                <Download className="h-3.5 w-3.5" />
              )}
              Download Error Report
            </button>
          )}
          <button
            onClick={onReupload}
            className="inline-flex items-center gap-2 px-4 py-2 rounded-2xl text-xs font-bold text-stone-600 bg-stone-100 hover:bg-stone-200 transition"
          >
            <RefreshCw className="h-3.5 w-3.5" />
            Re-upload
          </button>
        </div>
      </div>

      {/* Table */}
      <div className="overflow-x-auto rounded-2xl ring-1 ring-stone-100">
        <table className="w-full min-w-[900px] text-sm">
          <thead>
            <tr className="bg-stone-50/80 border-b border-stone-100">
              {[
                "File Source",
                "Row #",
                "Photo",
                "Name",
                "Aadhaar",
                "DOB",
                "Mobile",
                "Status",
                "Error",
              ].map((h) => (
                <th
                  key={h}
                  className="px-3 py-3 text-left text-[10px] font-bold uppercase tracking-widest text-stone-400 whitespace-nowrap"
                >
                  {h}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {displayRows.map((row, idx) => (
              <tr
                key={idx}
                className={`border-b border-stone-50 last:border-b-0 transition-colors ${
                  row.validationStatus === "invalid"
                    ? "bg-red-50/60 hover:bg-red-50"
                    : "hover:bg-stone-50/50"
                }`}
              >
                <td className="px-3 py-2.5">
                  <span className="text-xs text-stone-500 truncate block max-w-[140px]" title={row.fileName}>
                    {row.fileName || "—"}
                  </span>
                </td>
                <td className="px-3 py-2.5 tabular-nums text-xs text-stone-400">
                  {row.rowNumber ?? idx + 1}
                </td>
                <td className="px-3 py-2.5">
                  <PhotoCell src={row.photoThumbnail || row.photo} name={row.name} />
                </td>
                <td className="px-3 py-2.5 font-semibold text-stone-800 whitespace-nowrap">
                  {row.name || "—"}
                </td>
                <td className="px-3 py-2.5 font-mono text-xs text-stone-600 whitespace-nowrap">
                  {row.aadhaarNumber
                    ? `XXXX XXXX ${String(row.aadhaarNumber).slice(-4)}`
                    : row.aadhaar
                    ? `XXXX XXXX ${String(row.aadhaar).slice(-4)}`
                    : "—"}
                </td>
                <td className="px-3 py-2.5 text-xs text-stone-600 whitespace-nowrap">
                  {row.dateOfBirth || row.dob || "—"}
                </td>
                <td className="px-3 py-2.5 font-mono text-xs text-stone-600">
                  {row.mobileNumber || row.mobile || "—"}
                </td>
                <td className="px-3 py-2.5">
                  <StatusChip status={row.validationStatus} />
                </td>
                <td className="px-3 py-2.5">
                  {row.errorMessage ? (
                    <span className="text-xs text-red-600 font-medium leading-snug">
                      {row.errorMessage}
                    </span>
                  ) : (
                    <span className="text-stone-300 text-xs">—</span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* Show more */}
      {rows.length > 50 && !showAll && (
        <button
          onClick={() => setShowAll(true)}
          className="w-full py-2.5 text-xs font-semibold text-stone-500 hover:text-amber-600 transition"
        >
          Show all {rows.length} rows…
        </button>
      )}
    </div>
  );
}

