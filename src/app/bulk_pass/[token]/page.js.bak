}

// ── Main page ─────────────────────────────────────────────────────────────────

export default function BulkPassPublicPage() {
  const params = useParams();
  const token = params?.token;

  // Batch loading
  const [batch, setBatch] = useState(null);
  const [loadingBatch, setLoadingBatch] = useState(true);
  const [batchError, setBatchError] = useState(null); // "invalid" | "expired" | null

  // Upload phase
  const [files, setFiles] = useState([]);
  const [uploading, setUploading] = useState(false);

  // Preview phase
  const [uploadedFilePaths, setUploadedFilePaths] = useState(null); // server paths returned after upload
  const [previewRows, setPreviewRows] = useState(null);
  const [previewing, setPreviewing] = useState(false);

  // Submit phase
  const [submitting, setSubmitting] = useState(false);
  const [submitted, setSubmitted] = useState(false);

  // Template download
  const [downloadingTemplate, setDownloadingTemplate] = useState(false);

  // ── Load batch on mount ──────────────────────────────────────────────────

  useEffect(() => {
    if (!token) return;
    let alive = true;
    (async () => {
      try {
        setLoadingBatch(true);
        const data = await getPublicBatch(token);
        if (!alive) return;
        setBatch(data);
      } catch (err) {
        if (!alive) return;
        const status = err?.response?.status;
        const msg = err?.response?.data?.message || "";
        if (status === 404 || msg.toLowerCase().includes("invalid")) {
          setBatchError("invalid");
        } else if (
          status === 403 ||
          msg.toLowerCase().includes("expired") ||
          msg.toLowerCase().includes("inactive")
        ) {
          setBatchError("expired");
        } else {
          setBatchError("expired"); // default to expired for unknown errors
        }
      } finally {
        if (alive) setLoadingBatch(false);
      }
    })();
    return () => { alive = false; };
  }, [token]);

  // ── Actions ──────────────────────────────────────────────────────────────

  const handleDownloadTemplate = async () => {
    setDownloadingTemplate(true);
    try {
      const blob = await downloadTemplate();
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "bulk_pass_template.xlsx";
      a.click();
      URL.revokeObjectURL(url);
    } catch (err) {
      toast.error(
        err?.response?.data?.message || "Failed to download template."
      );
    } finally {
      setDownloadingTemplate(false);
    }
  };

  const handleUploadAndPreview = async () => {
    if (!files.length) {
      toast.error("Please select at least one Excel file.");
      return;
    }

    // Step 1: upload files
    setUploading(true);
    let paths;
    try {
      const uploadResult = await uploadExcelFiles(token, files);
      // uploadResult is an array of { originalName, filePath, size } objects
      // Extract the server-side filePath strings for the preview call
      if (Array.isArray(uploadResult)) {
        paths = uploadResult.map((r) =>
          typeof r === "string" ? r : r.filePath || r.path || r
        );
      } else {
        paths = uploadResult?.filePaths || uploadResult?.paths || [];
      }
      setUploadedFilePaths(paths);
    } catch (err) {
      toast.error(
        err?.response?.data?.message ||
          err?.response?.data?.error ||
          "File upload failed. Please try again."
      );
      setUploading(false);
      return;
    }
    setUploading(false);

    // Step 2: parse & preview
    setPreviewing(true);
    try {
      const result = await parsePreview(token, paths);
      const rows = result?.rows || result || [];
      setPreviewRows(rows);
    } catch (err) {
      toast.error(
        err?.response?.data?.message ||
          err?.response?.data?.error ||
          "Failed to parse files. Please check your Excel format."
      );
    } finally {
      setPreviewing(false);
    }
  };

  const handleReupload = () => {
    setPreviewRows(null);
    setUploadedFilePaths(null);
    setFiles([]);
  };

  const handleSubmit = async () => {
    setSubmitting(true);
    try {
      await submitBulkBatch(token);
      setSubmitted(true);
      toast.success("Batch submitted successfully.");
    } catch (err) {
      toast.error(
        err?.response?.data?.message ||
          err?.response?.data?.error ||
          "Submission failed. Please try again."
      );
    } finally {
      setSubmitting(false);
    }
  };

  // ── Derived state ────────────────────────────────────────────────────────

  const canSubmit =
    previewRows !== null &&
    previewRows.length > 0 &&
    previewRows.every((r) => r.validationStatus === "valid");

  const errorCount = previewRows
    ? previewRows.filter((r) => r.validationStatus === "invalid").length
    : 0;

  const isProcessing = uploading || previewing;

  // ── Render guards ─────────────────────────────────────────────────────────

  if (submitted) {
    return <ConfirmationScreen refNo={batch?.refNo} />;
  }

  if (loadingBatch) {
    return (
      <div className="min-h-screen bg-gradient-to-br from-stone-50 to-amber-50/30 flex items-center justify-center">
        <div className="flex flex-col items-center gap-3">
          <div className="h-10 w-10 rounded-full border-4 border-amber-400 border-t-transparent animate-spin" />
          <p className="text-sm text-stone-500">Loading…</p>
        </div>
      </div>
    );
  }

  if (batchError === "invalid") return <ErrorScreen type="invalid" />;
  if (batchError === "expired") return <ErrorScreen type="expired" />;

  // ── Main render ───────────────────────────────────────────────────────────

  return (
    <div
      className="min-h-screen bg-gradient-to-br from-stone-50 to-amber-50/30"
      style={{ fontFamily: "'Montserrat', sans-serif" }}
    >
      {/* Nav strip */}
      <div className="sticky top-0 z-20 bg-white/90 backdrop-blur-sm border-b border-stone-200/70 px-6 py-3 flex items-center justify-between">
        <div className="flex items-center gap-3">
          <div className="flex h-8 w-8 items-center justify-center rounded-xl bg-amber-400 text-white font-black text-sm">
            H
          </div>
          <div>
            <p className="text-xs font-bold text-stone-800 leading-none">
              HEP Automation
            </p>
            <p className="text-[10px] text-stone-400 leading-none mt-0.5">
              Chennai Port Authority
            </p>
          </div>
        </div>
        {batch?.refNo && (
          <span className="text-xs font-mono font-bold text-amber-700 bg-amber-100 px-3 py-1.5 rounded-full">
            {batch.refNo}
          </span>
        )}
      </div>

      <div className="max-w-6xl mx-auto px-4 py-8 flex flex-col gap-6">
        {/* ── Intake info ── */}
        <IntakeCard batch={batch} />

        {/* ── Step 1: Download template ── */}
        <div className={cardShell}>
          <div className="p-6">
            <SectionHeading
              icon={<FileSpreadsheet className="h-4 w-4" />}
              title="Step 1 — Download Template"
            />
            <p className="text-sm text-stone-500 mb-4 leading-relaxed">
              Download the official Excel template. Fill in all visitor details
              and embed passport-size photos in the designated photo column
              before uploading.
            </p>
            <div className="flex flex-wrap items-center gap-3">
              <button
                onClick={handleDownloadTemplate}
                disabled={downloadingTemplate}
                className="inline-flex items-center gap-2.5 px-6 py-3 rounded-2xl bg-amber-400 hover:bg-amber-500 disabled:opacity-60 disabled:cursor-not-allowed text-[#1f1f1f] font-bold text-sm shadow-sm transition"
              >
                {downloadingTemplate ? (
                  <Loader2 className="h-4 w-4 animate-spin" />
                ) : (
                  <Download className="h-4 w-4" />
                )}
                Download Template (.xlsx)
              </button>
            </div>
            <div className="mt-4 px-4 py-3 rounded-2xl bg-stone-50 ring-1 ring-stone-100">
              <p className="text-xs font-semibold text-stone-600 mb-2">
                Required columns:
              </p>
              <div className="flex flex-wrap gap-2">
                {[
                  "Name",
                  "Aadhaar Number",
                  "Date of Birth",
                  "Mobile Number",
                  "Photo (embedded)",
                ].map((col) => (
                  <span
                    key={col}
                    className="inline-block px-2.5 py-1 rounded-lg bg-amber-100 text-amber-800 text-xs font-semibold"
                  >
                    {col}
                  </span>
                ))}
              </div>
            </div>

            {/* Photo requirements */}
            <div className="mt-3 px-4 py-3 rounded-2xl bg-blue-50 ring-1 ring-blue-100">
              <p className="text-xs font-bold text-blue-700 mb-2 flex items-center gap-1.5">
                <ImageIcon className="h-3.5 w-3.5" />
                Photo requirements (embedded in Photo column):
              </p>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-1 text-xs text-blue-700">
                <span>• Format: JPEG or PNG</span>
                <span>• Max size: 500 KB</span>
                <span>• Min dimensions: 200 × 200 px</span>
                <span>• Max dimensions: 600 × 600 px</span>
                <span className="sm:col-span-2">• Aspect ratio: between 0.8 : 1 and 1.25 : 1 (near-square / passport-style)</span>
              </div>
            </div>
          </div>
        </div>

        {/* ── Step 2: Upload & preview (or show preview if already parsed) ── */}
        <div className={cardShell}>
          <div className="p-6">
            {previewRows === null ? (
              <>
                <SectionHeading
                  icon={<Upload className="h-4 w-4" />}
                  title="Step 2 — Upload Excel Files"
                />
                <p className="text-sm text-stone-500 mb-5 leading-relaxed">
                  Upload up to {MAX_FILES} completed Excel files (
                  {MAX_FILE_SIZE_MB} MB each). All files will be parsed and
                  validated together.
                </p>

                <UploadZone
                  files={files}
                  onFilesChange={setFiles}
                  uploading={isProcessing}
                />

                <div className="mt-5 flex justify-end">
                  <button
                    onClick={handleUploadAndPreview}
                    disabled={!files.length || isProcessing}
                    className="inline-flex items-center gap-2.5 px-7 py-3 rounded-2xl bg-amber-400 hover:bg-amber-500 disabled:opacity-60 disabled:cursor-not-allowed text-[#1f1f1f] font-bold text-sm shadow-sm transition"
                  >
                    {uploading ? (
                      <>
                        <Loader2 className="h-4 w-4 animate-spin" />
                        Uploading…
                      </>
                    ) : previewing ? (
                      <>
                        <Loader2 className="h-4 w-4 animate-spin" />
                        Parsing…
                      </>
                    ) : (
                      <>
                        <FileText className="h-4 w-4" />
                        Parse &amp; Preview
                      </>
                    )}
                  </button>
                </div>
              </>
            ) : (
              <>
                <SectionHeading
                  icon={<FileText className="h-4 w-4" />}
                  title="Step 2 — Preview &amp; Validate"
                />

                <PreviewTable
                  rows={previewRows}
                  token={token}
                  filePaths={uploadedFilePaths}
                  onReupload={handleReupload}
                />
              </>
            )}
          </div>
        </div>

        {/* ── Step 3: Submit ── */}
        {previewRows !== null && (
          <div className={cardShell}>
            <div className="p-6">
              <SectionHeading
                icon={<Send className="h-4 w-4" />}
                title="Step 3 — Submit"
              />

              {!canSubmit && errorCount > 0 ? (
                <div className="flex items-start gap-3 px-5 py-4 rounded-2xl bg-red-50 ring-1 ring-red-200 mb-4">
                  <AlertCircle className="h-5 w-5 text-red-500 shrink-0 mt-0.5" />
                  <div>
                    <p className="text-sm font-bold text-red-700">
                      {errorCount} row{errorCount !== 1 ? "s" : ""} with errors
                    </p>
                    <p className="text-xs text-red-600 mt-0.5">
                      Fix all errors before submitting. Download the error
                      report, correct the Excel files, and re-upload.
                    </p>
                  </div>
                </div>
              ) : previewRows.length === 0 ? (
                <div className="flex items-start gap-3 px-5 py-4 rounded-2xl bg-orange-50 ring-1 ring-orange-200 mb-4">
                  <AlertCircle className="h-5 w-5 text-orange-500 shrink-0 mt-0.5" />
                  <p className="text-sm text-orange-700">
                    No rows were parsed from the uploaded files. Please check
                    your Excel and re-upload.
                  </p>
                </div>
              ) : (
                <div className="flex items-start gap-3 px-5 py-4 rounded-2xl bg-emerald-50 ring-1 ring-emerald-200 mb-4">
                  <CheckCircle2 className="h-5 w-5 text-emerald-500 shrink-0 mt-0.5" />
                  <p className="text-sm font-semibold text-emerald-700">
                    All {previewRows.length} rows are valid. Ready to submit.
                  </p>
                </div>
              )}

              <div className="flex flex-wrap justify-end gap-3">
                <button
                  onClick={handleReupload}
                  disabled={submitting}
                  className="inline-flex items-center gap-2 px-5 py-3 rounded-2xl text-sm font-semibold text-stone-600 bg-stone-100 hover:bg-stone-200 disabled:opacity-50 transition"
                >
                  <RefreshCw className="h-4 w-4" />
                  Re-upload
                </button>
                <button
                  onClick={handleSubmit}
                  disabled={!canSubmit || submitting}
                  className="inline-flex items-center gap-2.5 px-8 py-3 rounded-2xl bg-amber-400 hover:bg-amber-500 disabled:opacity-60 disabled:cursor-not-allowed text-[#1f1f1f] font-bold text-sm shadow-sm transition"
                >
                  {submitting ? (
                    <>
                      <Loader2 className="h-4 w-4 animate-spin" />
                      Submitting…
                    </>
                  ) : (
                    <>
                      <Send className="h-4 w-4" />
                      Submit Batch
                    </>
                  )}
                </button>
              </div>
            </div>
          </div>
        )}

        {/* Footer */}
        <p className="text-center text-xs text-stone-400 pb-4">
          Chennai Port Authority · HEP Automation System · Secure Upload Portal
        </p>
      </div>
    </div>
  );
}
